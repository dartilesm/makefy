{
    "extends": "@makefy/typescript-config/nextjs.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@/components/*": [
                "app/components/*"
            ],
            "@/styles/*": [
                "styles/*"
            ],
        }
    },
    "include": [
        "next-env.d.ts",
        "next.config.js",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "tailwind.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}