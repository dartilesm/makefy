{
  "name": "makefy",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "dotenvx run -f .env.development.local -- turbo dev",
    "dev:web": "dotenvx run -f .env.development.local -- turbo dev --filter=@makefy/web --env-mode=loose",
    "dev:chat-with-pdf": "turbo dev --filter=@makefy/chat-with-pdf --env-mode=loose",
    "dev:text-tools": "dotenvx run -f .env.development.local -- turbo dev --filter=@makefy/text-tools --env-mode=loose",
    "dev:tailor-resume": "dotenvx run -f .env.development.local -- turbo dev --filter=@makefy/tailor-resume --env-mode=loose",
    "build:web": "dotenvx run -f .env.development.local -- turbo build --filter=@makefy/web --env-mode=loose",
    "build:chat-with-pdf": "dotenvx run -f .env.development.local -- turbo build --filter=@makefy/chat-with-pdf --env-mode=loose",
    "build:text-tools": "dotenvx run -f .env.development.local -- turbo build --filter=@makefy/text-tools --env-mode=loose",
    "build:tailor-resume": "dotenvx run -f .env.development.local -- turbo build --filter=@makefy/tailor-resume --env-mode=loose",
    "start:db": "dotenvx run -f .env.development.local -- turbo start:db --filter=@makefy/supabase --env-mode=loose",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "commit": "sui-mono commit"
  },
  "devDependencies": {
    "@makefy/eslint-config": "workspace:*",
    "@makefy/typescript-config": "workspace:*",
    "@s-ui/mono": "2.45.0",
    "dotenv-cli": "7.4.2",
    "eslint-config-next": "14.2.5",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.5.14",
    "tsx": "4.16.0",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.0.35",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {}
}